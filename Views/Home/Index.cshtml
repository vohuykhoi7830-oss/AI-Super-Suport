                    </div>
                    <button class="btn" style="width:100%;padding:14px;background:linear-gradient(135deg,#d97706,#f59e0b);color:#000;font-weight:800" onclick="generateQuiz('TOEIC')">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Generate TOEIC Quiz
                    </button>
                </div>
            </div>
            <div class="card">
                <div class="card-title"><i class="fa-solid fa-trophy" style="color:var(--gold)"></i> Score</div>
                <div id="toeic-score-display" style="font-family:'Syne',sans-serif;font-size:60px;font-weight:900;text-align:center;color:var(--gold);margin:20px 0">—</div>
                <div id="toeic-score-detail" style="text-align:center;color:var(--text2);font-size:13px"></div>
                <div id="toeic-quiz-progress" style="margin-top:20px;display:none">
                    <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text3);margin-bottom:6px">
