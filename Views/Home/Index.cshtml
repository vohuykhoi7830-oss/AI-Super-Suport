                                <span style="font-size:13px;font-weight:600">🎧 Listening</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--text3);margin-bottom:6px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px">Nguồn câu hỏi</div>
                        <select id="toeic-q-src" class="inp">
                            <option value="ai">🤖 AI Random (TOEIC business topics)</option>
                            <option value="doc">📄 From uploaded document</option>
                            <option value="vocab">📚 From your vocabulary</option>
                        </select>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--text3);margin-bottom:6px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px">Score Target</div>
                        <select id="toeic-q-lvl" class="inp">
                            <option value="500+">🟢 500+ — Basic</option>
                            <option value="700+" selected>🟡 700+ — Intermediate</option>
                            <option value="850+">🔴 850+ — Advanced</option>
                        </select>
                    </div>
                    <div>
                        <div style="font-size:12px;color:var(--text3);margin-bottom:8px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px">
                            Số câu: <span id="toeic-q-count-lbl" style="color:var(--gold);font-family:'Syne',sans-serif;font-size:16px">10</span>
                        </div>
                        <input type="range" id="toeic-q-count" min="5" max="40" step="5" value="10"
