                    </div>
                    <div style="height:6px;background:var(--bg3);border-radius:10px;overflow:hidden">
                        <div id="toeic-prog-bar" style="height:100%;background:linear-gradient(90deg,#d97706,#f59e0b);border-radius:10px;transition:width 0.4s;width:0%"></div>
