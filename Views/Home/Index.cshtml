<!-- ════ SECTION: CHAT ════ -->
<section id="s-chat" class="section">
    <div class="topbar">
        <div>
            <div class="page-title">AI Research <span>Coach</span></div>
            <div class="page-sub">Trợ lý AI thông minh — chat, phân tích tài liệu, giải bài tập, nghiên cứu đa lĩnh vực.</div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            <div style="display:flex;gap:6px">
                <button class="btn sm ghost" onclick="quickChat('Tóm tắt cuộc hội thoại này và những điểm chính đã học')" title="Tóm tắt chat" style="font-size:11px;padding:5px 9px">
                    <i class="fa-solid fa-list-check"></i>
                </button>
                <button class="btn sm ghost" onclick="exportChatHistory()" title="Xuất lịch sử chat" style="font-size:11px;padding:5px 9px">
                    <i class="fa-solid fa-file-export"></i>
                </button>
            </div>
            <div class="ai-badge">
                <i class="fa-solid fa-robot" style="margin-right:4px;font-size:11px"></i>AI Research Coach
            </div>
        </div>
    </div>

    <div class="chat-wrapper">
        <!-- Topic chips — horizontal scrollable -->
        <div class="context-chips" style="overflow-x:auto;flex-wrap:nowrap;padding-bottom:4px">
            <span class="ctx-chip" onclick="quickChat('Giải thích sự khác nhau giữa Present Perfect và Simple Past với ví dụ thực tế')">
                <i class="fa-solid fa-book-open" style="font-size:10px"></i> Grammar
            </span>
            <span class="ctx-chip" onclick="quickChat('Cho tôi 10 từ vựng IELTS band 7-8 với phát âm IPA, nghĩa, và ví dụ câu')">
                <i class="fa-solid fa-spell-check" style="font-size:10px"></i> Vocabulary
            </span>
            <span class="ctx-chip" onclick="quickChat('Give me a Speaking Part 2 topic and a full sample answer at band 7 level')">
                <i class="fa-solid fa-microphone" style="font-size:10px"></i> Speaking
            </span>
            <span class="ctx-chip" onclick="quickChat('Tạo một bài Writing Task 2 về Technology và hướng dẫn outline chi tiết')">
                <i class="fa-solid fa-pen-nib" style="font-size:10px"></i> Writing
            </span>
            <span class="ctx-chip" onclick="quickChat('Giải thích các chiến lược làm bài Reading IELTS để đạt band 7+')">
                <i class="fa-solid fa-glasses" style="font-size:10px"></i> Reading
            </span>
            <span class="ctx-chip" onclick="quickChat('Phân tích email sau đây và giúp tôi viết lại theo phong cách chuyên nghiệp hơn')">
                <i class="fa-solid fa-envelope" style="font-size:10px"></i> Business Email
            </span>
            <span class="ctx-chip" onclick="quickChat('Giải thích khái niệm này bằng tiếng Việt với ví dụ dễ hiểu')">
                <i class="fa-solid fa-lightbulb" style="font-size:10px"></i> Giải thích
            </span>
        </div>

        <!-- Messages -->
        <div id="chat-messages" class="chat-messages">
            <div class="msg">
                <div class="avatar ai"><i class="fa-solid fa-microchip-ai" style="font-size:12px"></i></div>
                <div class="bubble ai" style="max-width:460px">
                    <div style="font-weight:700;font-size:14px;margin-bottom:8px;color:var(--text)">
                        <i class="fa-solid fa-robot" style="color:var(--accent);margin-right:6px"></i>Xin chào! Tôi là AI Research Coach
                    </div>
                    <div style="font-size:13px;color:var(--text2);line-height:1.6">
                        Tôi có thể giúp bạn với:
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:8px">
                            <div style="padding:5px 8px;background:rgba(59,130,246,0.08);border-radius:7px;font-size:12px"><i class="fa-solid fa-graduation-cap" style="color:var(--accent);margin-right:4px"></i>IELTS / TOEIC</div>
                            <div style="padding:5px 8px;background:rgba(139,92,246,0.08);border-radius:7px;font-size:12px"><i class="fa-solid fa-file-lines" style="color:var(--accent2);margin-right:4px"></i>Phân tích tài liệu</div>
                            <div style="padding:5px 8px;background:rgba(16,185,129,0.08);border-radius:7px;font-size:12px"><i class="fa-solid fa-language" style="color:var(--green);margin-right:4px"></i>Dịch thuật</div>
                            <div style="padding:5px 8px;background:rgba(245,158,11,0.08);border-radius:7px;font-size:12px"><i class="fa-solid fa-magnifying-glass" style="color:var(--gold);margin-right:4px"></i>Nghiên cứu</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input area -->
        <div style="position:relative">
            <!-- Plus popup menu -->
            <div class="chat-plus-menu" id="chat-plus-menu">
                <input type="file" id="chat-file-input" multiple accept="image/*,.pdf,.docx,.txt,.md,.csv,.json" style="display:none" onchange="handleChatFileUpload(event)">
                <button class="chat-menu-item" onclick="document.getElementById('chat-file-input').click();togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(59,130,246,0.12)"><i class="fa-solid fa-paperclip" style="color:var(--accent)"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Đính kèm tệp</div><div style="font-size:11px;color:var(--text3)">PDF, DOCX, TXT, ảnh...</div></div>
                </button>
                <button class="chat-menu-item" onclick="handleChatImagePaste();togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(139,92,246,0.12)"><i class="fa-solid fa-clipboard" style="color:var(--accent2)"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Dán từ clipboard</div><div style="font-size:11px;color:var(--text3)">Ctrl+V ảnh hoặc text</div></div>
                </button>
                <div class="chat-menu-sep"></div>
                <button class="chat-menu-item" onclick="quickChat('Tôi muốn luyện Speaking IELTS Part 2. Hãy cho tôi một topic ngẫu nhiên và hướng dẫn trả lời.');togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(16,185,129,0.12)"><i class="fa-solid fa-microphone-lines" style="color:var(--green)"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Luyện Speaking</div><div style="font-size:11px;color:var(--text3)">IELTS Part 1, 2, 3</div></div>
                </button>
                <button class="chat-menu-item" onclick="quickChat('Hãy tạo một bài Writing Task 2 ngẫu nhiên về chủ đề xã hội và hướng dẫn tôi viết từng bước.');togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(245,158,11,0.12)"><i class="fa-solid fa-pen-nib" style="color:var(--gold)"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Writing Task 2</div><div style="font-size:11px;color:var(--text3)">Tạo đề + hướng dẫn</div></div>
                </button>
                <button class="chat-menu-item" onclick="quickChat('Hãy giải thích 10 từ vựng học thuật IELTS band 7-8 với IPA, ví dụ câu và cách dùng.');togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(6,182,212,0.12)"><i class="fa-solid fa-book" style="color:var(--accent3)"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Từ vựng học thuật</div><div style="font-size:11px;color:var(--text3)">Band 7-8 với IPA</div></div>
                </button>
                <button class="chat-menu-item" onclick="quickChat('Phân tích và sửa lỗi ngữ pháp trong đoạn văn sau:');togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(236,72,153,0.12)"><i class="fa-solid fa-spell-check" style="color:#ec4899"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Sửa ngữ pháp</div><div style="font-size:11px;color:var(--text3)">Grammar check & fix</div></div>
                </button>
                <div class="chat-menu-sep"></div>
                <button class="chat-menu-item" onclick="clearChatHistory();togglePlusMenu()">
                    <span class="mi-icon" style="background:rgba(239,68,68,0.1)"><i class="fa-solid fa-trash-can" style="color:var(--red)"></i></span>
                    <div><div style="font-weight:700;font-size:13px">Xoá lịch sử</div><div style="font-size:11px;color:var(--text3)">Bắt đầu cuộc hội thoại mới</div></div>
                </button>
            </div>

            <div class="chat-input-wrap" id="chat-input-wrap">
                <!-- Voice recording bar -->
                <div class="chat-voice-bar" id="voice-recording-bar">
                    <div class="voice-dot"></div>
                    <span style="font-size:12px;color:var(--red);font-weight:600">Đang ghi âm...</span>
                    <div class="voice-wave"><div class="voice-wave-fill" id="voice-level-bar"></div></div>
                    <span style="font-size:11px;color:var(--text3)">Nhấn mic để dừng</span>
                </div>
                <!-- Attachment chips -->
                <div class="chat-attach-chips" id="chat-attach-preview" style="display:none"></div>
                <!-- Text area -->
                <textarea id="chat-input"
                    placeholder="Hãy nhập câu hỏi vào đây....."
                    rows="1"
                    oninput="autoresizeChat(this)"
                    onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChat();}"></textarea>
                <!-- Bottom bar -->
                <div class="chat-input-bottom">
                    <button class="chat-plus-btn" id="chat-plus-btn" onclick="togglePlusMenu()" title="Thêm tệp, ảnh, tính năng" style="font-size:18px;font-weight:300">
                        <i class="fa-solid fa-circle-plus" style="font-size:16px"></i>
                    </button>
                    <div style="flex:1"></div>
                    <button class="chat-mic-btn" id="mic-btn" onclick="toggleMic()" title="Ghi âm giọng nói">
                        <i class="fa-solid fa-microphone"></i>
                    </button>
                    <button class="chat-send-btn" onclick="sendChat()" title="Gửi (Enter)">
                        <i class="fa-solid fa-paper-plane" style="font-size:13px"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

</div><!-- /main -->

