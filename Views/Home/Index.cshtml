    <div class="adm-body">

      <!-- Mini stats -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px">
        <div class="adm-stat">
          <div class="adm-stat-icon" style="background:rgba(59,130,246,0.12)"><i class="fa-solid fa-users" style="color:var(--accent)"></i></div>
          <div><div class="adm-stat-val" style="color:var(--accent)" id="stat-total2">0</div><div class="adm-stat-lbl">Total Users</div></div>
        </div>
        <div class="adm-stat" style="border-color:rgba(16,185,129,0.25)">
          <div class="adm-stat-icon" style="background:rgba(16,185,129,0.12)"><i class="fa-solid fa-circle" style="color:var(--green);font-size:10px"></i></div>
          <div><div class="adm-stat-val" style="color:var(--green)" id="stat-active">0</div><div class="adm-stat-lbl">Active Today</div></div>
        </div>
        <div class="adm-stat">
          <div class="adm-stat-icon" style="background:rgba(139,92,246,0.12)"><i class="fa-solid fa-shield-halved" style="color:var(--accent2)"></i></div>
          <div><div class="adm-stat-val" style="color:var(--accent2)" id="stat-admins">0</div><div class="adm-stat-lbl">Admins</div></div>
        </div>
        <div class="adm-stat">
          <div class="adm-stat-icon" style="background:rgba(245,158,11,0.12)"><i class="fa-solid fa-bolt" style="color:var(--gold)"></i></div>
          <div><div class="adm-stat-val" style="color:var(--gold)" id="stat-mods">0</div><div class="adm-stat-lbl">Moderators</div></div>
        </div>
      </div>

      <!-- ── OVERVIEW TAB ── -->
      <div id="atab-overview">
        <div class="card" style="margin-bottom:16px;border-color:rgba(16,185,129,0.2)">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <div class="card-title" style="margin:0;color:var(--green)">
              <i class="fa-solid fa-circle" style="font-size:9px;animation:pulse 2s infinite"></i> Users Online Now
            </div>
            <span id="online-count-badge" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);color:var(--green);padding:2px 10px;border-radius:20px;font-size:12px;font-weight:700">0 online</span>
          </div>
          <div id="online-users-list" style="display:flex;flex-wrap:wrap;gap:8px">
            <div style="color:var(--text3);font-size:13px;padding:10px">No users currently online.</div>
          </div>
        </div>
        <div class="card">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <div class="card-title" style="margin:0"><i class="fa-solid fa-bolt" style="color:var(--gold)"></i> Recent Activity</div>
            <button onclick="switchAdminTab('activity')" class="btn sm ghost"><i class="fa-solid fa-arrow-right"></i> View All</button>
          </div>
          <div id="activity-log-preview" style="display:flex;flex-direction:column;gap:6px;max-height:380px;overflow-y:auto"></div>
        </div>
      </div>

      <!-- ── USERS TAB ── -->
      <div id="atab-users" style="display:none">
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px">
            <div class="card-title" style="margin:0"><i class="fa-solid fa-users" style="color:var(--accent)"></i> User Management</div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <input type="text" class="inp" placeholder="🔍 Search users..." style="width:180px" oninput="renderAdminUsers(this.value)">
              <select class="inp" style="width:120px" onchange="filterAdminUsers(this.value)" id="user-role-filter">
                <option value="">All roles</option>
                <option value="admin">Admin</option>
                <option value="moderator">Moderator</option>
                <option value="user">User</option>
              </select>
              <button class="btn sm" onclick="openAddUserModal()"><i class="fa-solid fa-plus"></i> Add User</button>
            </div>
          </div>
          <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;font-size:13px" id="admin-user-table">
              <thead>
                <tr style="border-bottom:1px solid var(--border2)">
                  <th style="text-align:left;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">User</th>
                  <th style="text-align:left;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">Role</th>
                  <th style="text-align:left;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">Status</th>
                  <th style="text-align:left;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">Last Active</th>
                  <th style="text-align:left;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">Actions</th>
                  <th style="text-align:left;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">Features</th>
                  <th style="text-align:right;padding:9px 12px;color:var(--text3);font-weight:700;text-transform:uppercase;font-size:11px">⋮</th>
                </tr>
              </thead>
              <tbody id="admin-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ── ACTIVITY TAB ── -->
      <div id="atab-activity" style="display:none">
        <div class="card">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px">
            <div class="card-title" style="margin:0"><i class="fa-solid fa-chart-line" style="color:var(--green)"></i> Full Activity Log</div>
            <div style="display:flex;gap:8px;align-items:center">
              <select class="inp" style="width:130px" id="log-type-filter" onchange="renderActivityLog()">
                <option value="">All types</option>
                <option value="login">Login</option>
                <option value="logout">Logout</option>
                <option value="register">Register</option>
                <option value="admin">Admin</option>
                <option value="info">Info</option>
              </select>
              <input type="text" class="inp" placeholder="🔍 Search logs..." style="width:170px" id="log-search" oninput="renderActivityLog()">
              <button class="btn sm ghost" onclick="exportActivityLog()"><i class="fa-solid fa-download"></i> Export</button>
            </div>
          </div>
          <div id="activity-log" style="max-height:calc(100vh - 300px);overflow-y:auto;display:flex;flex-direction:column;gap:6px"></div>
        </div>
      </div>

      <!-- ── ANNOUNCE TAB ── -->
      <div id="atab-announce" style="display:none">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <div style="display:flex;flex-direction:column;gap:16px">
            <div class="card">
              <div class="card-title"><i class="fa-solid fa-globe" style="color:var(--accent)"></i> Gửi cho tất cả người dùng</div>
              <div style="margin-top:14px;display:flex;flex-direction:column;gap:10px">
                <select class="inp" id="announce-type">
                  <option value="info">ℹ️ Thông tin</option>
                  <option value="warning">⚠️ Cảnh báo</option>
                  <option value="success">✅ Thành công</option>
                  <option value="error">🚨 Khẩn cấp</option>
                </select>
                <input type="text" class="inp" id="announce-title" placeholder="Tiêu đề thông báo...">
                <textarea class="inp" id="announce-body" placeholder="Nội dung..." rows="4" style="resize:vertical;width:100%;box-sizing:border-box"></textarea>
                <button class="btn" onclick="sendAnnouncement('all')"><i class="fa-solid fa-paper-plane"></i> Gửi cho tất cả</button>
              </div>
            </div>
            <div class="card">
              <div class="card-title"><i class="fa-solid fa-user-check" style="color:var(--accent2)"></i> Gửi cho từng user</div>
              <div style="margin-top:14px;display:flex;flex-direction:column;gap:10px">
                <select class="inp" id="announce-target-user">
                  <option value="">-- Chọn user --</option>
                </select>
                <select class="inp" id="announce-type2">
                  <option value="info">ℹ️ Thông tin</option>
                  <option value="warning">⚠️ Cảnh báo</option>
                  <option value="success">✅ Thành công</option>
                  <option value="error">🚨 Khẩn cấp</option>
                </select>
                <input type="text" class="inp" id="announce-title2" placeholder="Tiêu đề...">
                <textarea class="inp" id="announce-body2" placeholder="Nội dung..." rows="3" style="resize:vertical;width:100%;box-sizing:border-box"></textarea>
                <button class="btn" style="background:linear-gradient(135deg,var(--accent2),#6d28d9)" onclick="sendAnnouncement('user')"><i class="fa-solid fa-paper-plane"></i> Gửi cho user này</button>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-clock-rotate-left" style="color:var(--gold)"></i> Lịch sử thông báo</div>
            <div id="announce-history" style="margin-top:14px;max-height:calc(100vh - 260px);overflow-y:auto;display:flex;flex-direction:column;gap:8px">
              <div style="color:var(--text3);font-size:13px;text-align:center;padding:20px">Chưa có thông báo nào.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── SYSTEM TAB ── -->
      <div id="atab-system" style="display:none">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-server" style="color:var(--accent)"></i> Thông tin hệ thống</div>
            <div style="margin-top:14px;display:flex;flex-direction:column;gap:8px">
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">Platform</span><span style="font-size:12px;font-weight:700;color:var(--text)">Railway · ASP.NET 9</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">AI Model</span><span style="font-size:12px;font-weight:700;color:var(--text)">Llama 3.3 70B (Groq)</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">Database</span><span style="font-size:12px;font-weight:700;color:var(--green)">Firebase Realtime DB</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">Server Time</span><span style="font-size:12px;font-weight:700;color:var(--text)" id="sys-time">--</span>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-title"><i class="fa-solid fa-key" style="color:var(--gold)"></i> API Status</div>
            <div style="margin-top:14px;display:flex;flex-direction:column;gap:8px">
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">GROQ API Key</span><span id="sys-groq-status" style="font-size:12px;font-weight:700">Checking...</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">Firebase</span><span style="font-size:12px;font-weight:700;color:var(--green)">● Connected</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:9px 12px;background:rgba(255,255,255,0.03);border-radius:9px;border:1px solid var(--border2)">
                <span style="font-size:12px;color:var(--text2)">Proxy /api/chat</span><span id="sys-proxy-status" style="font-size:12px;font-weight:700">Checking...</span>
              </div>
            </div>
          </div>
        </div>
        <div class="card" style="border-color:rgba(239,68,68,0.2)">
          <div class="card-title" style="color:var(--red)"><i class="fa-solid fa-triangle-exclamation"></i> Vùng nguy hiểm</div>
          <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;background:rgba(239,68,68,0.05);border:1px solid rgba(239,68,68,0.15);border-radius:10px">
              <div><div style="font-size:13px;font-weight:700;color:var(--text)">Xóa toàn bộ Activity Log</div><div style="font-size:11px;color:var(--text3);margin-top:2px">Không thể hoàn tác</div></div>
              <button class="btn sm" style="background:rgba(239,68,68,0.15);color:var(--red);border:1px solid var(--red)" onclick="clearAllLogs()"><i class="fa-solid fa-trash"></i> Xóa log</button>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;background:rgba(239,68,68,0.05);border:1px solid rgba(239,68,68,0.15);border-radius:10px">
              <div><div style="font-size:13px;font-weight:700;color:var(--text)">Export toàn bộ Users</div><div style="font-size:11px;color:var(--text3);margin-top:2px">Tải xuống file JSON</div></div>
              <button class="btn sm ghost" onclick="exportUsers()"><i class="fa-solid fa-download"></i> Export JSON</button>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /adm-body -->
  </div><!-- /adm-main -->
</div><!-- /adm-wrap -->
</div>

<!-- Add User Modal -->
<div id="add-user-modal" style="position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9500;display:none;align-items:center;justify-content:center">
  <div style="background:var(--bg1);border:1px solid var(--border);border-radius:20px;padding:36px;width:400px;max-width:95vw">
    <div style="font-family:'Syne',sans-serif;font-size:20px;font-weight:900;margin-bottom:20px">➕ Add New User</div>
    <input type="text" id="add-username" class="inp" placeholder="Username" style="margin-bottom:12px">
    <input type="text" id="add-display" class="inp" placeholder="Display Name" style="margin-bottom:12px">
    <input type="password" id="add-pass" class="inp" placeholder="Password" style="margin-bottom:12px">
    <select id="add-role" class="inp" style="margin-bottom:20px">
      <option value="user">👤 User</option>
      <option value="moderator">⚡ Moderator (Phó quản trị)</option>
      <option value="admin">🛡️ Admin</option>
    </select>
    <div style="display:flex;gap:10px">
      <button class="btn" style="flex:1" onclick="doAddUser()"><i class="fa-solid fa-plus"></i> Add User</button>
      <button class="btn ghost" onclick="document.getElementById('add-user-modal').style.display='none'">Cancel</button>
    </div>
  </div>
</div>


<!-- Change Password Modal -->
<div id="change-pass-modal" style="position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:9600;display:none;align-items:center;justify-content:center">
  <div style="background:var(--bg1);border:1px solid var(--border);border-radius:20px;padding:36px;width:400px;max-width:95vw">
    <div style="font-family:'Syne',sans-serif;font-size:20px;font-weight:900;margin-bottom:6px">🔒 Change Password</div>
    <div style="color:var(--text3);font-size:13px;margin-bottom:20px" id="change-pass-user-label">Update your password</div>
    <input type="password" id="cp-current" class="inp" placeholder="Current Password" style="margin-bottom:12px">
    <input type="password" id="cp-new" class="inp" placeholder="New Password (min 6 chars)" style="margin-bottom:12px">
    <input type="password" id="cp-confirm" class="inp" placeholder="Confirm New Password" style="margin-bottom:20px">
    <div id="cp-error" style="color:var(--red);font-size:13px;margin-bottom:12px;display:none"></div>
    <div style="display:flex;gap:10px">
      <button class="btn" style="flex:1" onclick="doChangePass()"><i class="fa-solid fa-lock"></i> Update Password</button>
      <button class="btn ghost" onclick="document.getElementById('change-pass-modal').style.display='none'">Cancel</button>
    </div>
  </div>
</div>


<!-- User Activity Modal -->
<div id="user-activity-modal" style="position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:9700;display:none;align-items:center;justify-content:center;backdrop-filter:blur(8px)">
  <div style="background:var(--bg1);border:1px solid var(--border);border-radius:22px;padding:36px;width:600px;max-width:95vw;max-height:85vh;display:flex;flex-direction:column">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
      <div>
        <div style="font-family:'Syne',sans-serif;font-size:20px;font-weight:900" id="ua-title">User Activity</div>
        <div style="font-size:12px;color:var(--text3);margin-top:4px" id="ua-meta"></div>
      </div>
      <button class="btn ghost sm" onclick="document.getElementById('user-activity-modal').style.display='none'"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div style="border-top:1px solid var(--border2);margin:16px 0 12px"></div>
    <div id="ua-stats" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px"></div>
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-bottom:10px"><i class="fa-solid fa-list-ul" style="margin-right:6px"></i> Activity History <span id="ua-count" style="color:var(--text2);font-weight:400;text-transform:none;letter-spacing:0"></span></div>
    <div id="ua-log" style="overflow-y:auto;display:flex;flex-direction:column;gap:7px;flex:1"></div>
  </div>
</div>


<!-- Permissions Modal -->
<div id="perm-modal" style="position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:9800;display:none;align-items:center;justify-content:center;backdrop-filter:blur(10px)">
  <div style="background:var(--bg1);border:1px solid var(--border);border-radius:22px;padding:36px;width:520px;max-width:95vw;max-height:88vh;display:flex;flex-direction:column">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">
      <div>
        <div style="font-family:'Syne',sans-serif;font-size:20px;font-weight:900" id="perm-modal-title">Permissions</div>
        <div style="font-size:12px;color:var(--text3);margin-top:3px" id="perm-modal-sub"></div>
      </div>
      <button class="btn ghost sm" onclick="document.getElementById('perm-modal').style.display='none'"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <input type="hidden" id="perm-user-id">
    <div style="border-top:1px solid var(--border2);margin:14px 0 10px"></div>
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-bottom:10px"><i class="fa-solid fa-sliders" style="margin-right:6px;color:var(--accent2)"></i> Feature Access Control</div>
    <div id="perm-list" style="overflow-y:auto;display:flex;flex-direction:column;gap:8px;flex:1"></div>
    <div style="border-top:1px solid var(--border2);margin:16px 0 0;padding-top:16px;display:flex;gap:10px">
      <button class="btn" style="flex:1" onclick="savePermissions()"><i class="fa-solid fa-floppy-disk"></i> Save Permissions</button>
      <button class="btn ghost" onclick="document.getElementById('perm-modal').style.display='none'">Cancel</button>
    </div>
  </div>
</div>

<script src="/js/site.js"></script>
</body>
</html>
