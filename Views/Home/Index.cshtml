<style>
:root {
    --bg: #070b14;
    --bg1: #0d1526;
    --bg2: #111d35;
    --bg3: #16263f;
    --accent: #3b82f6;
    --accent2: #8b5cf6;
    --accent3: #06b6d4;
    --gold: #f59e0b;
    --green: #10b981;
    --red: #ef4444;
    --text: #f0f6ff;
    --text2: #7a9cc5;
    --text3: #4a6a9a;
    --border: rgba(59,130,246,0.15);
    --border2: rgba(255,255,255,0.07);
    --glass: rgba(13,21,38,0.92);
    --glow: 0 0 40px rgba(59,130,246,0.15);
    --glow2: 0 0 30px rgba(139,92,246,0.2);
    --sidebar: 72px;
    --r: 18px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    height: 100vh;
    overflow: hidden;
    position: relative;
}

/* ═══ BACKGROUND ═══ */
#bg-canvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }

.noise-overlay {
    position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 150px;
}

/* ═══ SIDEBAR ═══ */
.sidebar {
    position: fixed; left: 0; top: 0;
    width: var(--sidebar); height: 100vh;
    background: rgba(7,11,20,0.98);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column; align-items: center;
    padding: 20px 0; z-index: 200;
    backdrop-filter: blur(20px);
}

.logo-mark {
    width: 42px; height: 42px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif;
    font-weight: 900; font-size: 13px; color: white;
    margin-bottom: 28px;
    box-shadow: 0 0 20px rgba(59,130,246,0.4);
    letter-spacing: -0.5px;
}

.nav-group { display: flex; flex-direction: column; gap: 4px; flex: 1; width: 100%; padding: 0 10px; }

.nav-btn {
    width: 52px; height: 52px; border-radius: 14px;
    background: transparent; border: 1px solid transparent;
    color: var(--text3); cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; position: relative;
}
.nav-btn:hover { background: rgba(59,130,246,0.1); color: var(--accent); border-color: var(--border); }
.nav-btn.active {
    background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(139,92,246,0.15));
    color: var(--text); border-color: var(--accent);
    box-shadow: var(--glow);
}
.nav-btn .tooltip {
    position: absolute; left: calc(100% + 14px);
    background: var(--bg2); border: 1px solid var(--border);
    padding: 6px 12px; border-radius: 8px;
    font-size: 12px; font-weight: 600; white-space: nowrap;
    opacity: 0; pointer-events: none; transform: translateX(-4px);
    transition: all 0.2s; color: var(--text); font-family: 'DM Sans', sans-serif;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
}
.nav-btn:hover .tooltip { opacity: 1; transform: translateX(0); }

.streak-pill {
    margin-top: auto;
    background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(239,68,68,0.1));
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 12px; padding: 8px 6px;
    text-align: center; cursor: default;
}
.streak-pill .fire { font-size: 18px; }
.streak-pill .num { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 900; color: var(--gold); line-height: 1; }
.streak-pill .lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.5px; }

/* ═══ MAIN ═══ */
.main { margin-left: var(--sidebar); height: 100vh; overflow-y: auto; position: relative; z-index: 10; }

.section { display: none; min-height: 100vh; padding: 36px; animation: fadeUp 0.4s ease forwards; }
.section.active { display: block; }

@@keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

/* ═══ TOPBAR ═══ */
.topbar {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 32px;
}
.page-title { font-family: 'Syne', sans-serif; font-size: 34px; font-weight: 900; line-height: 1; }
.page-title span { 
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.page-sub { color: var(--text2); font-size: 14px; margin-top: 7px; }

.ai-badge {
    display: flex; align-items: center; gap: 8px;
    background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.25);
    padding: 8px 16px; border-radius: 30px; font-size: 12px; font-weight: 600;
    color: var(--green);
}
.ai-badge::before {
    content: ''; width: 8px; height: 8px;
    background: var(--green); border-radius: 50%;
    animation: pulse 2s infinite;
}
@@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.8)} }

/* ═══ CARDS ═══ */
.card {
    background: var(--bg1);
    border: 1px solid var(--border2);
    border-radius: var(--r);
    padding: 24px;
    backdrop-filter: blur(20px);
    transition: border-color 0.3s;
}
.card:hover { border-color: var(--border); }
.card-title { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }

/* ═══ INPUTS ═══ */
.inp {
    width: 100%; background: rgba(255,255,255,0.04);
    border: 1px solid var(--border2); border-radius: 12px;
    padding: 13px 16px; color: var(--text); font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.25s; outline: none;
}
.inp:focus { border-color: var(--accent); background: rgba(59,130,246,0.06); box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
.inp::placeholder { color: var(--text3); }

select.inp option { background: var(--bg2); color: var(--text); }

textarea.inp { resize: vertical; min-height: 100px; line-height: 1.6; }

/* ═══ BUTTONS ═══ */
.btn {
    background: linear-gradient(135deg, var(--accent), #2563eb);
    color: white; border: none; padding: 12px 22px;
    border-radius: 12px; font-weight: 700; font-size: 14px;
    cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    transition: all 0.2s; font-family: 'DM Sans', sans-serif;
    white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(59,130,246,0.4); }
.btn:active { transform: scale(0.98); }
.btn.purple { background: linear-gradient(135deg, var(--accent2), #7c3aed); }
.btn.purple:hover { box-shadow: 0 8px 24px rgba(139,92,246,0.4); }
.btn.teal { background: linear-gradient(135deg, var(--accent3), #0891b2); }
.btn.sm { padding: 8px 16px; font-size: 13px; border-radius: 9px; }
.btn.icon { width: 42px; height: 42px; padding: 0; justify-content: center; border-radius: 11px; }
.btn.ghost { background: transparent; border: 1px solid var(--border); color: var(--text2); box-shadow: none; }
.btn.ghost:hover { border-color: var(--accent); color: var(--accent); box-shadow: none; transform: none; }
.btn.danger { background: rgba(239,68,68,0.15); color: var(--red); border: 1px solid rgba(239,68,68,0.2); box-shadow: none; }
.btn.danger:hover { background: rgba(239,68,68,0.25); box-shadow: none; transform: none; }

/* ═══ GRID UTILS ═══ */
.g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.g3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
.g4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; }
.flex { display: flex; }
.flex-gap { display: flex; gap: 12px; }
.flex-center { display: flex; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }

/* ═══ RESULT BOX ═══ */
.result-box {
    background: rgba(0,0,0,0.25); border-radius: 14px;
    border-left: 3px solid var(--accent);
    padding: 20px; margin-top: 18px;
    min-height: 80px; font-size: 15px; line-height: 1.8;
    color: var(--text); white-space: pre-wrap;
    max-height: 380px; overflow-y: auto;
}

/* ═══ SECTION 1: TRANSLATOR ═══ */
.translate-main {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
    border: 1px solid var(--border2); border-radius: var(--r); overflow: hidden;
    background: var(--bg1); margin-top: 20px;
}
.trans-pane { padding: 24px; }
.trans-pane:first-child { border-right: 1px solid var(--border2); }
.trans-lang {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1px; color: var(--text2); margin-bottom: 12px;
    display: flex; align-items: center; gap: 6px;
}
.translate-main textarea { min-height: 180px; background: transparent; border: none; font-size: 16px; }
.translate-main textarea:focus { box-shadow: none; }
.trans-result { min-height: 180px; font-size: 16px; line-height: 1.8; color: var(--text); padding-top: 0; }

.quick-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
.chip {
    background: rgba(255,255,255,0.05); border: 1px solid var(--border2);
    border-radius: 20px; padding: 5px 14px; font-size: 12px; cursor: pointer;
    transition: 0.2s; color: var(--text2);
}
.chip:hover { border-color: var(--accent); color: var(--text); background: rgba(59,130,246,0.1); }

/* ═══ SECTION 2: VOCAB ═══ */
.vocab-card {
    background: var(--bg2); border: 1px solid var(--border2);
    border-radius: 16px; padding: 20px;
    transition: 0.25s; position: relative; overflow: hidden;
}
.vocab-card::after {
    content: ''; position: absolute; top: 0; right: 0;
    width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(59,130,246,0.1), transparent);
    border-radius: 0 0 0 60px;
}
.vocab-card:hover { border-color: var(--accent); transform: translateY(-2px); }
.vocab-word { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 800; }
.vocab-meaning { color: var(--text2); font-size: 13px; margin-top: 6px; line-height: 1.5; }
.vocab-actions { display: flex; gap: 6px; margin-top: 12px; }

/* ═══ SECTION 3: FILES ═══ */
.upload-zone {
    border: 2px dashed rgba(59,130,246,0.3);
    border-radius: 16px; padding: 44px;
    text-align: center; cursor: pointer;
    transition: 0.3s; background: rgba(59,130,246,0.03);
    position: relative;
}
.upload-zone:hover { border-color: var(--accent); background: rgba(59,130,246,0.07); }
.upload-icon { font-size: 38px; color: var(--accent); margin-bottom: 12px; }

.file-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; border-radius: 12px;
    background: rgba(255,255,255,0.03); border: 1px solid transparent;
    transition: 0.2s; cursor: pointer; margin-bottom: 8px;
}
.file-item:hover { border-color: var(--border); background: rgba(255,255,255,0.05); }
.file-name { font-size: 13px; font-weight: 600; color: var(--text); }
.file-meta { font-size: 11px; color: var(--text3); margin-top: 2px; }

/* ═══ SECTION 4: 4 SKILLS ═══ */
.skill-hero {
    padding: 28px; border-radius: 20px;
    text-align: center; cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    border: 1px solid var(--border2);
    background: var(--bg1); position: relative; overflow: hidden;
}
.skill-hero::before {
    content: ''; position: absolute; inset: 0;
    opacity: 0; transition: 0.3s;
}
.skill-hero.listening::before { background: radial-gradient(ellipse at 50% 100%, rgba(16,185,129,0.15), transparent 70%); }
.skill-hero.speaking::before  { background: radial-gradient(ellipse at 50% 100%, rgba(239,68,68,0.15), transparent 70%); }
.skill-hero.reading::before   { background: radial-gradient(ellipse at 50% 100%, rgba(59,130,246,0.15), transparent 70%); }
.skill-hero.writing::before   { background: radial-gradient(ellipse at 50% 100%, rgba(245,158,11,0.15), transparent 70%); }
.skill-hero:hover::before { opacity: 1; }
.skill-hero:hover { transform: translateY(-6px); }
.skill-hero.listening:hover { border-color: var(--green); }
.skill-hero.speaking:hover  { border-color: var(--red); }
.skill-hero.reading:hover   { border-color: var(--accent); }
.skill-hero.writing:hover   { border-color: var(--gold); }

.skill-icon-wrap {
    width: 60px; height: 60px; border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; margin: 0 auto 16px;
}
.listening .skill-icon-wrap { background: rgba(16,185,129,0.12); color: var(--green); }
.speaking .skill-icon-wrap  { background: rgba(239,68,68,0.12); color: var(--red); }
.reading .skill-icon-wrap   { background: rgba(59,130,246,0.12); color: var(--accent); }
.writing .skill-icon-wrap   { background: rgba(245,158,11,0.12); color: var(--gold); }

.skill-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 16px; margin-bottom: 4px; }
.skill-desc { font-size: 12px; color: var(--text2); line-height: 1.5; }

.skill-control {
    display: flex; gap: 12px; align-items: center;
    margin-bottom: 20px; flex-wrap: wrap;
}

.level-selector { display: flex; gap: 6px; }
.lvl-btn {
    padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 700;
    border: 1px solid var(--border2); background: transparent;
    color: var(--text2); cursor: pointer; transition: 0.2s;
}
.lvl-btn:hover, .lvl-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
.lvl-btn.medium.active { background: var(--gold); border-color: var(--gold); }
.lvl-btn.hard.active { background: var(--red); border-color: var(--red); }

.skill-result {
    background: rgba(0,0,0,0.3); border-radius: 16px;
    padding: 24px; min-height: 200px; line-height: 1.8;
    font-size: 14px; border: 1px solid var(--border2);
    white-space: pre-wrap; position: relative;
}
.skill-result.loading { display: flex; align-items: center; justify-content: center; color: var(--text2); }

.data-source-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
.tab-btn {
    padding: 8px 18px; border-radius: 10px; font-size: 13px; font-weight: 600;
    border: 1px solid var(--border2); background: transparent; color: var(--text2); cursor: pointer; transition: 0.2s;
}
.tab-btn.active { background: rgba(59,130,246,0.15); border-color: var(--accent); color: var(--text); }

/* ═══ SECTION 5: QUIZ ═══ */
.quiz-options {
    display: flex; flex-direction: column; gap: 10px; margin-top: 16px;
}
.quiz-opt {
    padding: 14px 20px; border-radius: 12px;
    border: 1px solid var(--border2); background: rgba(255,255,255,0.02);
    cursor: pointer; transition: all 0.2s; font-size: 14px; line-height: 1.5;
    text-align: left; color: var(--text); width: 100%;
}
.quiz-opt:hover { border-color: var(--accent); background: rgba(59,130,246,0.08); }
.quiz-opt.correct { border-color: var(--green) !important; background: rgba(16,185,129,0.1) !important; color: var(--green); }
.quiz-opt.wrong   { border-color: var(--red) !important; background: rgba(239,68,68,0.1) !important; color: var(--red); }

.quiz-question { font-size: 17px; font-weight: 600; line-height: 1.6; margin-bottom: 6px; }
.quiz-num { font-size: 12px; color: var(--text3); font-family: 'JetBrains Mono', monospace; margin-bottom: 16px; }

.answer-reveal {
    margin-top: 14px; padding: 16px; border-radius: 12px;
    background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2);
    font-size: 13px; line-height: 1.7; color: var(--text2); display: none;
}
.answer-reveal.show { display: block; }

.score-bar {
    display: flex; gap: 16px; background: var(--bg2);
    border-radius: 14px; padding: 16px 20px; margin-bottom: 20px;
    border: 1px solid var(--border2);
}
.score-item { text-align: center; }
.score-num { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 900; }
.score-lbl { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

/* ═══ SECTION 6: AI CHAT ═══ */
.chat-wrapper { display: flex; flex-direction: column; height: calc(100vh - 160px); }
.chat-messages {
    flex: 1; overflow-y: auto; padding: 4px 0 20px;
    display: flex; flex-direction: column; gap: 16px;
}
.msg { display: flex; gap: 12px; align-items: flex-start; }
.msg.user { flex-direction: row-reverse; }
.avatar {
    width: 34px; height: 34px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0; font-family: 'Syne', sans-serif; font-weight: 800;
}
.avatar.ai { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: white; font-size: 10px; }
.avatar.user { background: rgba(255,255,255,0.1); color: var(--text2); }
.bubble {
    padding: 13px 18px; border-radius: 16px;
    max-width: 75%; font-size: 14px; line-height: 1.7;
    white-space: pre-wrap;
}
.bubble.ai { background: var(--bg2); border: 1px solid var(--border2); border-bottom-left-radius: 4px; }
.bubble.user { background: linear-gradient(135deg, var(--accent), #2563eb); border-bottom-right-radius: 4px; }

/* old bar hidden */
.chat-input-bar { display: none; }

/* ── ChatGPT-style input wrap ── */
.chat-input-wrap {
    position: relative;
    background: var(--bg2);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 12px 14px 8px 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.chat-input-wrap:focus-within {
    border-color: rgba(59,130,246,0.5);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.08);
}
.chat-input-wrap textarea {
    width: 100%; background: transparent; border: none; outline: none;
    color: var(--text); font-size: 15px; font-family: 'DM Sans', sans-serif;
    line-height: 1.65; resize: none; min-height: 26px; max-height: 160px;
    overflow-y: auto; display: block;
}
.chat-input-wrap textarea::placeholder { color: var(--text3); }

/* voice bar inside */
.chat-voice-bar {
    display: none; align-items: center; gap: 10px;
    padding: 4px 0 6px; border-bottom: 1px solid var(--border2); margin-bottom: 6px;
}
.chat-voice-bar.active { display: flex; }
.voice-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: pulse 1s infinite; flex-shrink:0; }
.voice-wave { flex: 1; height: 4px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
.voice-wave-fill { height: 100%; background: var(--red); border-radius: 4px; width: 0%; transition: width 0.1s; }

/* attachment chips */
.chat-attach-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
.attach-chip {
    display: flex; align-items: center; gap: 6px;
    background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.25);
    border-radius: 8px; padding: 5px 8px; font-size: 12px; color: var(--text);
}
.attach-chip img { width: 28px; height: 28px; border-radius: 4px; object-fit: cover; }
.attach-chip-remove { background: none; border: none; color: var(--text3); cursor: pointer; font-size: 12px; padding: 0 2px; }
.attach-chip-remove:hover { color: var(--red); }

/* bottom row of input */
.chat-input-bottom {
    display: flex; align-items: center; gap: 6px; margin-top: 8px;
}
.chat-plus-btn {
    width: 34px; height: 34px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.15);
    background: transparent; color: var(--text2);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 19px; line-height:1;
    transition: all 0.18s; flex-shrink: 0;
}
.chat-plus-btn:hover { background: rgba(255,255,255,0.08); border-color: var(--text2); color: var(--text); }
.chat-plus-btn.active { background: var(--text); color: var(--bg); border-color: var(--text); transform: rotate(45deg); }

.chat-mic-btn {
    width: 36px; height: 36px; border-radius: 50%;
    background: transparent; border: none; color: var(--text2);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 17px; transition: all 0.18s; flex-shrink: 0;
    margin-left: auto;
}
.chat-mic-btn:hover { color: var(--text); background: rgba(255,255,255,0.07); }
.chat-mic-btn.recording { color: var(--red); background: rgba(239,68,68,0.12); }

.chat-send-btn {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--text); border: none; color: var(--bg);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 15px; transition: all 0.18s; flex-shrink: 0;
}
.chat-send-btn:hover { transform: scale(1.06); }
.chat-send-btn:disabled { background: rgba(255,255,255,0.1); color: var(--text3); cursor: not-allowed; transform: none; }

/* plus popup menu */
.chat-plus-menu {
    position: absolute; bottom: calc(100% + 10px); left: 0;
    background: var(--bg2); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px; padding: 6px; min-width: 210px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.7); backdrop-filter: blur(20px);
    z-index: 500; display: none; flex-direction: column; gap: 2px;
    animation: menuPop 0.15s cubic-bezier(.34,1.56,.64,1);
}
.chat-plus-menu.open { display: flex; }
@@keyframes menuPop {
    from { opacity: 0; transform: translateY(8px) scale(0.95); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}
.chat-menu-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 13px; border-radius: 10px; cursor: pointer;
    font-size: 14px; color: var(--text); transition: background 0.15s;
    border: none; background: transparent; width: 100%; text-align: left;
    font-family: 'DM Sans', sans-serif; font-weight: 500;
}
.chat-menu-item:hover { background: rgba(255,255,255,0.07); }
.chat-menu-item .mi-icon {
    width: 34px; height: 34px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
}
.chat-menu-sep { height: 1px; background: var(--border2); margin: 3px 6px; }

.thinking { display: flex; align-items: center; gap: 5px; padding: 13px 18px; }
.dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text2); animation: bounce 1.2s infinite; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@@keyframes bounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-6px)} }

.context-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
.ctx-chip {
    padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;
    background: rgba(255,255,255,0.05); border: 1px solid var(--border2);
    cursor: pointer; transition: 0.2s; color: var(--text2);
}
.ctx-chip:hover { border-color: var(--accent); color: var(--text); }

/* ═══ SPINNER ═══ */
.spinner { display: inline-block; width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.2); border-top-color: white; border-radius: 50%; animation: spin 0.7s linear infinite; }
@@keyframes spin { to { transform: rotate(360deg); } }

/* ═══ SCROLLBAR ═══ */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(59,130,246,0.35); border-radius: 10px; }

/* ═══ MISC ═══ */
.sep { height: 1px; background: var(--border2); margin: 20px 0; }
.tag { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; }
.tag.blue { background: rgba(59,130,246,0.15); color: var(--accent); }
.tag.green { background: rgba(16,185,129,0.15); color: var(--green); }
.tag.gold { background: rgba(245,158,11,0.15); color: var(--gold); }
.hidden { display: none !important; }

.progress-ring { position: relative; display: inline-block; }
.progress-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-weight: 900; font-size: 13px; }


/* ═══ USER ACTION MENU ═══ */
.umenu-item {
    padding: 9px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
    cursor: pointer; color: var(--text2); display: flex; align-items: center; gap: 10px;
    transition: background 0.15s, color 0.15s; white-space: nowrap;
}
.umenu-item:hover { background: rgba(255,255,255,0.07); color: var(--text); }
.umenu-item.danger { color: var(--red); }
.umenu-item.danger:hover { background: rgba(239,68,68,0.12); }

/* ═══ CHANGE PASSWORD MODAL ═══ */
#change-pass-modal { position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:9600;display:none;align-items:center;justify-content:center; }

/* ═══ API KEY MODAL ═══ */
.modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.8);
    z-index: 1000; display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(10px);
}
.modal-box {
    background: var(--bg1); border: 1px solid var(--border);
    border-radius: 24px; padding: 40px; width: 480px; max-width: 90vw;
}
.modal-box h2 { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 900; margin-bottom: 8px; }

@@keyframes wavePulse {
    from { transform: scaleY(0.4); opacity: 0.5; }
    to   { transform: scaleY(1.4); opacity: 1; }
}
@@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
}
</style>
</head>
<body>

<canvas id="bg-canvas"></canvas>
<div class="noise-overlay"></div>

<!-- API KEY MODAL (disabled) -->
<div id="api-modal" class="modal-overlay hidden" style="display:none!important">
    <div class="modal-box">
        <div style="font-size: 36px; margin-bottom: 16px;">🔑</div>
        <h2>Enter Groq API Key</h2>
        <p style="color:var(--text2); font-size:14px; margin-bottom:24px; line-height:1.6;">To use all AI features, please enter your Groq API Key. Key is stored locally in your browser. Lấy key tại <a href="https://console.groq.com/keys" target="_blank" style="color:var(--accent)">console.groq.com</a></p>
        <input type="password" id="api-key-input" class="inp" placeholder="gsk_..." style="margin-bottom:16px;">
        <div style="display:flex; gap:10px;">
            <button class="btn" style="flex:1" onclick="saveApiKey()"><i class="fa-solid fa-key"></i> Save & Connect</button>
            <button class="btn ghost" onclick="closeModal()">Bỏ qua</button>
        </div>
        <p style="font-size:11px; color:var(--text3); margin-top:16px; text-align:center;">Your key is stored locally only, never sent to any server.</p>
    </div>
</div>

<!-- SIDEBAR -->
<nav class="sidebar">
    <div class="logo-mark" title="AI Supper Support"><i class="fa-solid fa-brain" style="font-size:18px"></i></div>
    <div class="nav-group">
        <button class="nav-btn active" onclick="goTo('translate', event)" title="">
            <i class="fa-solid fa-earth-asia"></i>
            <span class="tooltip">AI Translator</span>
        </button>
        <button class="nav-btn" onclick="goTo('vocab', event)" title="">
            <i class="fa-solid fa-book-bookmark"></i>
            <span class="tooltip">Vocabulary Bank</span>
        </button>
        <button class="nav-btn" onclick="goTo('files', event)" title="">
            <i class="fa-solid fa-file-circle-check"></i>
            <span class="tooltip">File AI Solver</span>
        </button>
        <button class="nav-btn" onclick="goTo('ielts', event)" title="">
            <i class="fa-solid fa-spell-check"></i>
            <span class="tooltip">IELTS Lab</span>
        </button>
        <button class="nav-btn" onclick="goTo('toeic', event)" title="">
            <i class="fa-solid fa-briefcase"></i>
            <span class="tooltip">TOEIC Lab</span>
        </button>
        <button class="nav-btn" onclick="goTo('chat', event)" title="">
            <i class="fa-solid fa-comments"></i>
            <span class="tooltip">AI Research Coach</span>
        </button>
        <div style="margin-top: 4px; width: 100%; padding: 0 10px;">
            <button class="nav-btn" onclick="openAdmin()" title="" style="width:52px;display:none" id="admin-nav-btn">
                <i class="fa-solid fa-gauge-high"></i>
                <span class="tooltip">Admin Dashboard</span>
            </button>
        </div>
    </div>
    <div style="width:100%;padding:0 10px;margin-bottom:4px">
        <button class="nav-btn" onclick="openChangePassModal()" title="" style="width:52px" id="change-pass-btn">
            <i class="fa-solid fa-user-shield"></i>
            <span class="tooltip">Change Password</span>
        </button>
    </div>
    <div style="width:100%;padding:0 10px;margin-bottom:8px">
        <button class="nav-btn" style="width:52px;color:var(--red);border-color:rgba(239,68,68,0.2)" onclick="doLogout()" title="">
            <i class="fa-solid fa-power-off"></i>
            <span class="tooltip">Sign Out</span>
        </button>
    </div>
    <div class="streak-pill" title="Streak">
        <div class="fire">🔥</div>
        <div class="num" id="streak-val">0</div>
        <div class="lbl">streak</div>
    </div>
</nav>

<!-- MAIN -->
<div class="main">

<!-- ════ SECTION: TRANSLATE ════ -->
<section id="s-translate" class="section active">
    <div class="topbar">
        <div>
            <div class="page-title">AI <span>Instant</span> Translator</div>
            <div class="page-sub">Tự động nhận diện & dịch — không cần chọn ngôn ngữ. Auto-detect & translate — no language selection needed. Powered by Groq (Llama 3.3 70B).</div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            <div class="notif-bell-wrap" id="notif-bell-wrap">
                <button class="notif-bell-btn" onclick="toggleNotifDropdown()" title="Thông báo">
                    <i class="fa-solid fa-bell"></i>
                </button>
                <span class="notif-badge" id="notif-badge">0</span>
                <div class="notif-dropdown" id="notif-dropdown">
                    <div class="notif-header">
                        <span style="font-weight:700;font-size:14px;color:var(--text)"><i class="fa-solid fa-bell" style="color:var(--accent);margin-right:6px"></i>Thông báo</span>
                        <button onclick="markAllRead()" style="background:none;border:none;color:var(--accent);font-size:12px;cursor:pointer;font-weight:600">Đọc hết</button>
                    </div>
                    <div class="notif-list" id="notif-list">
                        <div style="padding:24px;text-align:center;color:var(--text3);font-size:13px">Không có thông báo</div>
                    </div>
                </div>
            </div>
            <div class="ai-badge">AI Online</div>
        </div>
    </div>

    <!-- Image translate input -->
    <input type="file" id="img-trans-input" accept="image/*" style="display:none" onchange="translateImage(event)">

    <!-- Mode selector bar -->
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid var(--border2);border-radius:14px;flex-wrap:wrap">
        <div style="font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-right:4px;white-space:nowrap">
            <i class="fa-solid fa-sliders" style="color:var(--accent);margin-right:4px"></i>Ngữ cảnh dịch:
        </div>
        <select id="trans-mode" class="inp" style="width:auto;min-width:160px;padding:5px 10px;font-size:12px;font-weight:600" onchange="autoTranslate()">
            <option value="auto">🔄 Tự động (Auto-detect)</option>
            <option value="formal">🏢 Trang trọng / Formal</option>
            <option value="casual">😊 Thông thường / Casual</option>
            <option value="academic">🎓 Học thuật / Academic</option>
            <option value="technical">⚙️ Kỹ thuật / Technical</option>
            <option value="creative">✨ Sáng tạo / Creative</option>
        </select>
        <div style="margin-left:auto;display:flex;gap:6px">
            <button id="tab-text-btn" onclick="switchTransTab('text')" style="padding:5px 12px;border-radius:8px;border:1px solid var(--accent);background:rgba(59,130,246,0.15);color:var(--text);font-size:12px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:5px">
                <i class="fa-solid fa-pen-line" style="font-size:11px"></i> Text
            </button>
            <button id="tab-img-btn" onclick="switchTransTab('image')" style="padding:5px 12px;border-radius:8px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-size:12px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:5px">
                <i class="fa-solid fa-image" style="font-size:11px"></i> Image
            </button>
        </div>
    </div>

    <div class="translate-main">
        <div class="trans-pane">
            <div style="display:flex;align-items:center;margin-bottom:10px">
                <div style="display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:1px">
                    <i class="fa-solid fa-circle" style="color:var(--accent);font-size:7px"></i> NGUỒN VĂN BẢN
                </div>
            </div>

            <!-- Text tab -->
            <div id="trans-tab-text">
                <textarea id="trans-input" class="inp" style="min-height:220px;background:transparent;border:none;font-size:15px;line-height:1.8;resize:vertical"
                    placeholder="Nhập văn bản bằng bất kỳ ngôn ngữ nào...&#10;AI sẽ tự nhận diện và dịch theo ngữ cảnh đã chọn." oninput="autoTranslate()"></textarea>
            </div>

            <!-- Image tab -->
            <div id="trans-tab-image" style="display:none">
                <div id="img-drop-zone" onclick="document.getElementById('img-trans-input').click()"
                    style="min-height:220px;border:2px dashed rgba(59,130,246,0.3);border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:0.3s;background:rgba(59,130,246,0.03);gap:12px"
                    ondragover="event.preventDefault();this.style.borderColor='var(--accent)'"
                    ondragleave="this.style.borderColor='rgba(59,130,246,0.3)'"
                    ondrop="handleImgDrop(event)">
                    <div style="width:52px;height:52px;border-radius:14px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center">
                        <i class="fa-solid fa-image fa-lg" style="color:var(--accent)"></i>
                    </div>
                    <div>
                        <div style="font-size:14px;font-weight:700;color:var(--text2);text-align:center">Click hoặc kéo thả ảnh</div>
                        <div style="font-size:12px;color:var(--text3);text-align:center;margin-top:4px">JPG · PNG · WebP · GIF</div>
                    </div>
                </div>
                <div id="img-preview-wrap" style="display:none;margin-top:10px;position:relative">
                    <img id="img-preview" style="width:100%;border-radius:12px;max-height:220px;object-fit:contain;background:rgba(0,0,0,0.2)">
                    <button onclick="clearImgTrans()" style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.6);color:white;border:none;border-radius:8px;padding:4px 10px;cursor:pointer;font-size:12px"><i class="fa-solid fa-xmark"></i> Xoá</button>
                </div>
            </div>

            <div class="quick-actions" id="trans-quick-chips" style="margin-top:12px">
                <span class="chip" onclick="setTranslate('Hello, how are you today?')"><i class="fa-solid fa-hand-wave" style="font-size:10px"></i> Chào hỏi</span>
                <span class="chip" onclick="setTranslate('Dear Sir/Madam, I am writing to formally request...')"><i class="fa-solid fa-envelope" style="font-size:10px"></i> Email trang trọng</span>
                <span class="chip" onclick="setTranslate('The quick brown fox jumps over the lazy dog')"><i class="fa-solid fa-font" style="font-size:10px"></i> Câu mẫu</span>
                <span class="chip" onclick="clearTrans()"><i class="fa-solid fa-xmark" style="font-size:10px"></i> Xoá</span>
            </div>
        </div>

        <div class="trans-pane">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                <div style="display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:1px">
                    <i class="fa-solid fa-circle" style="color:var(--green);font-size:7px"></i> KẾT QUẢ DỊCH & PHÂN TÍCH
                </div>
            </div>
            <div id="trans-result" class="trans-result" style="min-height:220px;font-size:14px;line-height:1.8;color:var(--text2)">Kết quả dịch sẽ hiển thị ở đây khi bạn nhập văn bản...</div>
            <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
                <button class="btn sm ghost" onclick="speakResult()" style="display:flex;align-items:center;gap:5px">
                    <i class="fa-solid fa-volume-high"></i> Nghe
                </button>
                <button class="btn sm ghost" onclick="copyResult()" style="display:flex;align-items:center;gap:5px">
                    <i class="fa-solid fa-copy"></i> Sao chép
                </button>
                <button class="btn sm ghost" onclick="saveToVocab()" style="display:flex;align-items:center;gap:5px">
                    <i class="fa-solid fa-bookmark"></i> Lưu từ vựng
                </button>
            </div>
        </div>
    </div>

    <!-- Translation History Panel -->
    <div class="card" style="margin-top:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <div class="card-title" style="margin:0">
                <i class="fa-solid fa-clock-rotate-left" style="color:var(--accent)"></i> Lịch sử dịch
            </div>
            <div style="display:flex;gap:8px">
                <button class="btn sm ghost" onclick="renderTransHistory()">
                    <i class="fa-solid fa-rotate"></i> Làm mới
                </button>
                <button class="btn sm ghost" style="color:var(--red)" onclick="clearTransHistory()">
                    <i class="fa-solid fa-trash"></i> Xóa lịch sử
                </button>
            </div>
        </div>
        <div id="trans-history-list" style="max-height:280px;overflow-y:auto">
            <div style="color:var(--text3);font-size:12px;text-align:center;padding:16px">
                <i class="fa-solid fa-clock-rotate-left" style="margin-right:6px"></i>Chưa có lịch sử dịch.
            </div>
        </div>
    </div>

    <div class="g3" style="margin-top:24px">
        <div class="card">
            <div class="card-title"><i class="fa-solid fa-chart-bar" style="color:var(--accent)"></i> Today's Stats</div>
            <div style="font-family:'Syne',sans-serif;font-size:36px;font-weight:900;color:var(--accent)" id="daily-count">0</div>
            <div style="font-size:12px;color:var(--text3)">translations today</div>
        </div>
        <div class="card">
            <div class="card-title"><i class="fa-solid fa-book" style="color:var(--accent2)"></i> Vocabulary Bank</div>
            <div style="font-family:'Syne',sans-serif;font-size:36px;font-weight:900;color:var(--accent2)" id="vocab-count-home">0</div>
            <div style="font-size:12px;color:var(--text3)">words saved</div>
        </div>
        <div class="card">
            <div class="card-title"><i class="fa-solid fa-file" style="color:var(--accent3)"></i> Documents</div>
            <div style="font-family:'Syne',sans-serif;font-size:36px;font-weight:900;color:var(--accent3)" id="file-count-home">0</div>
            <div style="font-size:12px;color:var(--text3)">files saved</div>
        </div>
    </div>

    <!-- User Notification Panel -->
    <div id="user-notif-panel" style="margin-top:20px;display:none">
        <div class="card" style="border-color:rgba(59,130,246,0.25)">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
                <div class="card-title" style="margin:0">
                    <i class="fa-solid fa-bell" style="color:var(--accent)"></i> Thông báo từ Admin
                    <span id="home-notif-count" style="margin-left:8px;background:var(--red);color:white;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:800;display:none">0</span>
                </div>
                <button class="btn sm ghost" onclick="markAllRead()"><i class="fa-solid fa-check-double"></i> Đọc tất cả</button>
            </div>
            <div id="home-notif-list" style="display:flex;flex-direction:column;gap:8px">
                <div style="color:var(--text3);font-size:13px;text-align:center;padding:16px">Không có thông báo mới</div>
            </div>
        </div>
    </div>
</section>

<!-- ════ SECTION: VOCAB ════ -->
<section id="s-vocab" class="section">
    <div class="topbar">
        <div>
            <div class="page-title">Knowledge <span>Vault</span></div>
            <div class="page-sub">Your personal vocabulary library. Add manually or let AI generate.</div>
        </div>
        <div style="display:flex;gap:10px">
            <input type="text" id="vocab-search" class="inp" style="width:220px" placeholder="🔍 Search..." oninput="renderVocab()">
            <button class="btn purple" onclick="aiGenerateVocab()"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Generate Vocab</button>
        </div>
    </div>

    <div class="card" style="margin-bottom:20px">
        <div class="card-title"><i class="fa-solid fa-plus" style="color:var(--green)"></i> Add New Word</div>
        <div class="g3" style="gap:12px">
